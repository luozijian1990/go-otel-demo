{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "evidence_bundle_hash": {
      "title": "Evidence Bundle Hash",
      "type": "string"
    },
    "status": {
      "enum": [
        "diagnosed",
        "inconclusive",
        "no_anomaly"
      ],
      "title": "Status",
      "type": "string"
    },
    "summary": {
      "maxLength": 6000,
      "title": "Summary",
      "type": "string"
    },
    "root_service": {
      "enum": [
        "service-a",
        "service-b",
        "service-c",
        "service-d",
        "traefik",
        "none",
        "unknown"
      ],
      "title": "Root Service",
      "type": "string"
    },
    "root_component": {
      "enum": [
        "application",
        "mysql",
        "redis_client",
        "http_client",
        "none",
        "unknown"
      ],
      "title": "Root Component",
      "type": "string"
    },
    "cause_code": {
      "enum": [
        "application_error",
        "table_not_found",
        "connection_refused",
        "application_delay",
        "slow_query",
        "none",
        "unknown"
      ],
      "title": "Cause Code",
      "type": "string"
    },
    "impact_class": {
      "enum": [
        "failed",
        "slow",
        "degraded",
        "none",
        "unknown"
      ],
      "title": "Impact Class",
      "type": "string"
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "root_evidence_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "title": "Root Evidence Ids",
      "type": "array"
    },
    "propagation": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Propagation",
      "type": "array"
    },
    "supporting_findings": {
      "items": {
        "type": "string"
      },
      "maxItems": 30,
      "title": "Supporting Findings",
      "type": "array"
    },
    "counter_evidence": {
      "items": {
        "type": "string"
      },
      "maxItems": 30,
      "title": "Counter Evidence",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "maxItems": 30,
      "title": "Limitations",
      "type": "array"
    },
    "hypotheses": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Hypotheses",
      "type": "array"
    },
    "recommended_checks": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Recommended Checks",
      "type": "array"
    }
  },
  "required": [
    "evidence_bundle_hash",
    "status",
    "summary",
    "root_service",
    "root_component",
    "cause_code",
    "impact_class",
    "confidence",
    "root_evidence_ids"
  ],
  "title": "DiagnosisResult",
  "type": "object"
}
